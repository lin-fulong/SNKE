    "nullspace_threshold": 0.02,
    "L2": 0.5,
    "subgraph_size": 50,
    "gnn_fact_token_strategy": "avg",
    "gnn_weight_decay": 0.05,
    "gnn_dim_factor": 1,
    "gnn_attn_drop": 0.05,
    "gnn_feat_drop": 0.05,
